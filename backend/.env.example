# Configuración del Servidor
PORT=5000
NODE_ENV=development

# Configuración de Base de Datos MySQL (Individual)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gamerfest

# Alternativa para Producción en la Nube (Railway / Render / Supabase / Aiven)
# DATABASE_URL=mysql://usuario:password@host:port/database_name

# Habilitar SSL para bases de datos remotas (true / false)
DB_SSL=false

# Secreto para firma y validación de tokens JWT (OBLIGATORIO en producción)
JWT_SECRET=tu_secreto_super_seguro_para_jwt_aqui

# URL(s) permitidas para CORS en el Frontend (separadas por comas si son múltiples)
FRONTEND_URL=http://localhost:5173

# Contraseñas de los usuarios que crea el seed (npm run seed).
# Solo para desarrollo; en producción define valores propios NO uses los defaults.
# SEED_ADMIN_PASSWORD=admin123
# SEED_USER_PASSWORD=user123
